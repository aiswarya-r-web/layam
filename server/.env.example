PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/layam
JWT_SECRET=your_long_random_jwt_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: seed an admin account (used by npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Paw-sistant chat (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=heygen/heygen-voice-1-turbo:free

